{
  "name": "residencia-planner",
  "version": "1.0.0",
  "private": true,
  "description": "Residência Planner — planejamento de estudos para residência médica baseado no histórico das provas cadastradas pelo administrador. Site estático (GitHub Pages) + Supabase.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "build:app": "tsc -p tsconfig.json --noEmit && VITE_LOCAL=1 vite build && node scripts/build-local-db.mjs dist-app",
    "android:sync": "npm run build:app && cap sync android",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "supabase:schema": "node supabase/build-schema.mjs",
    "supabase:local": "node scripts/local-supabase.mjs",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:api": "vitest run tests/api",
    "test:e2e": "playwright test",
    "data:sql": "node scripts/build-data-sql.mjs && node scripts/build-template-sql.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@electric-sql/pglite": "^0.5.8",
    "@fontsource/arimo": "^5.3.0",
    "@fontsource/patrick-hand": "^5.3.0",
    "@fontsource/tinos": "^5.3.0",
    "@supabase/supabase-js": "^2.117.1",
    "@tanstack/react-query": "^5.103.2",
    "clsx": "^2.1.1",
    "lucide-react": "^1.48.0",
    "papaparse": "^5.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "read-excel-file": "^9.3.10",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "pg": "^8.23.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  }
}
