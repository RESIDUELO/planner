# Conexão usada pela API. Pode ser um papel dedicado membro de rp_app
# (recomendado em produção) ou o dono do banco: toda transação da API executa
# SET LOCAL ROLE rp_app, então as policies de RLS se aplicam de qualquer forma.
DATABASE_URL=postgres://rp_owner:rp_owner@localhost:5432/residencia_planner
# Papel dono das tabelas, usado apenas para migrações e scripts administrativos.
MIGRATION_DATABASE_URL=postgres://rp_owner:rp_owner@localhost:5432/residencia_planner
PORT=3001
# Em produção, defina COOKIE_SECURE=true (HTTPS)
COOKIE_SECURE=false
